{
  "schema": "arbiter-metadata/1",
  "project_name": "Arbiter",
  "description": "Auditable reasoning for third-party vendor onboarding: agents gather cited evidence, a versioned policy decides, and the next action is a signed contract.",
  "track": "Reasoning Architecture",
  "team": {
    "name": "Arbiter",
    "members": [
      {
        "name": "Josh Lennon",
        "github": "awkwardapples",
        "role": "Solo builder",
        "primary_contact": true
      }
    ]
  },
  "repository": "https://github.com/awkwardapples/Arbiter",
  "demo_video": "",
  "slide_deck": "",
  "entry_points": {
    "api": "POST http://localhost:8000/run",
    "cli": "python run.py assess --input input_examples/example_1.json",
    "docker_sample_mode": "docker run --rm -p 8000:8000 -e SAMPLE_MODE=true arbiter"
  },
  "track_mapping": {
    "Data": "Zetaris USL vendor_risk: five systems plus CISA KEV",
    "Knowledge": "Versioned policy-as-code (policy/arbiter_policy.v1.yaml)",
    "Memory": "Meterless H-MEM governed precedents",
    "Reasoning": "Planner, Evidence, Evaluator and Challenger tool loop on Nemotron via Nightshift",
    "Reliable": "Policy decides; live eval; replay",
    "Decisions": "Five outcomes with briefs",
    "Actions": "Signed execution contracts and approvals"
  },
  "impact": [
    {
      "stat": "Third parties are involved in 48% of breaches",
      "source": "Verizon 2026 DBIR",
      "url": "https://www.verizon.com/business/resources/Te26/reports/2026-dbir-data-breach-investigations-report.pdf"
    },
    {
      "stat": "Organisations average 2,643 third parties and assess 36%; 40% have an assessment backlog",
      "source": "ProcessUnity, State of Third-Party Risk Assessments 2026 (Ponemon-Sullivan, n = 1,465)",
      "url": "https://ponemonsullivanreport.com/2026/03/state-of-third-party-risk-assessments/"
    },
    {
      "stat": "Companies spend 37.4 hours a week assessing vendors; 94% can't assess every vendor they'd like",
      "source": "Whistic, 2025 TPRM Impact Report (n = 525)",
      "url": "https://www.whistic.com/resources/blog/2025-impact-report-takeaways"
    }
  ],
  "agents": [
    {
      "name": "Orchestrator",
      "role": "State machine driving INTAKE → DONE; not an LLM agent",
      "route": null
    },
    {
      "name": "PlannerAgent",
      "role": "Plans registry queries; revises on Evaluator/Challenger feedback",
      "route": "meterless/deep"
    },
    {
      "name": "EvidenceAgent",
      "role": "Runs registry queries; guards and extracts quoted vendor claims",
      "route": "meterless/fast"
    },
    {
      "name": "EvaluatorAgent",
      "role": "Grounds quotes, cross-checks claims against systems of record, sends work back",
      "route": "meterless/fast"
    },
    {
      "name": "ChallengerAgent",
      "role": "Attacks the candidate decision; can force re-plan or escalation only",
      "route": "meterless/deep"
    },
    {
      "name": "ReporterAgent",
      "role": "Writes the cited dossier and drafts actions",
      "route": "meterless/deep"
    },
    {
      "name": "PolicyEngine",
      "role": "Deterministic, versioned decision (no LLM)",
      "route": null
    },
    {
      "name": "MemoryKeeper",
      "role": "Meterless H-MEM precedents and trust ledger",
      "route": null
    },
    {
      "name": "ScoutGuard",
      "role": "Meterless Scout injection/PII guard",
      "route": "meterless/fast (ambiguous band)"
    },
    {
      "name": "ActionExecutor",
      "role": "Meterless Scout execution contracts; approval-gated actions",
      "route": null
    }
  ],
  "sponsor_technologies": {
    "zetaris": {
      "role": "Single SQL access point federating five enterprise systems and CISA KEV",
